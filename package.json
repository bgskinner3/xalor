{
  "name": "@bgskinner2/xalor",
  "description": "Ambient runtime type database for TypeScript. Solidifies ghost types into a global vault.",
  "version": "0.0.1-alpha.1",
  "author": "Brennan Skinner",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "keywords": [
    "typescript",
    "compiler-api",
    "ts-patch",
    "runtime-validation",
    "type-guards",
    "ambient-types",
    "code-generation",
    "ast-transformer",
    "metadata-extraction",
    "isomorphic-validation",
    "zero-allocation",
    "content-addressable",
    "hot-reload"
  ],
  "typesVersions": {
    "*": {
      "*": [
        "./dist/index.d.ts"
      ]
    }
  },
  "bin": {
    "xalor": "./dist/cli/bin.js"
  },
  "typescript": {
    "plugins": [
      {
        "transform": "./dist/transformer/index.cjs",
        "type": "program"
      }
    ],
    "serverPlugins": [
      {
        "name": "@bgskinner2/xalor/transformer"
      }
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./transformer": {
      "types": "./dist/transformer/index.d.ts",
      "import": "./dist/transformer/index.js",
      "require": "./dist/transformer/index.cjs"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.js",
      "require": "./dist/plugins/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": true,
  "dependencies": {
    "tslib": "^2.6.2"
  },
  "peerDependenciesMeta": {
    "ts-patch": {
      "optional": true
    }
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "devDependencies": {
    "@eslint/config-inspector": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^29.5.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.41",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.5.0",
    "jest": "^29.7.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.59.0"
  },
  "scripts": {
    "clean": "rm -rf dist .cache tsconfig.build.tsbuildinfo tsconfig.test.tsbuildinfo",
    "clean:pack": "rm -f *.tgz",
    "build": "pnpm run clean && tsc --project tsconfig.build.json --noEmit && tsup",
    "test": "npm run build && jest",
    "release:canary": "npm run test && npm version prerelease --preid=alpha && npm publish --tag alpha",
    "postinstall": "node dist/scripts/postinstall.js",
    "lint": "tsc --noEmit && eslint --ext .js,.ts,.tsx .",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write '**/*.{js,ts,jsx,tsx,json,css,md,mdx}'",
    "format:check": "prettier --check '**/*.{js,ts,jsx,tsx,json,css,md,mdx}'",
    "sandbox:pack": "pnpm run clean:pack && pnpm run build && pnpm pack",
    "codegen": "npx tsx scripts/generate-configs.ts && npm run format"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bgskinner3/axiom-kit/tree/main/packages/xalor",
    "directory": "packages/xalor"
  },
  "bugs": {
    "url": "https://github.com/bgskinner3/axiom-kit/tree/main/packages/xalor"
  },
  "homepage": "git+https://github.com/bgskinner3/axiom-kit/tree/main/packages/xalor",
  "engines": {
    "node": ">=16.0.0",
    "pnpm": ">=8.0.0"
  }
}
